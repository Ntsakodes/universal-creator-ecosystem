# Copy to .env at repository root. Never commit the resulting file.
NODE_ENV=development
DATABASE_URL=postgresql://uce:local-development-only@localhost:5432/uce?schema=public
APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
PORT=4000
# Public Cognito app client: authorization-code grant, PKCE, no client secret.
# Allowed callback: http://localhost:3000/api/v1/auth/callback
# Allowed sign-out URL: http://localhost:3000
AUTH_ISSUER=https://cognito-idp.af-south-1.amazonaws.com/REPLACE_POOL_ID
AUTH_DOMAIN=https://REPLACE.auth.af-south-1.amazoncognito.com
AUTH_CLIENT_ID=
AWS_REGION=af-south-1
# Private, versioning-enabled bucket. Configure browser CORS for APP_URL PUT.
S3_BUCKET=
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Provision IAM credentials through your runtime/role; never commit access keys.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_MODEL=
AI_API_KEY=
# OpenAI-compatible or Anthropic messages endpoint, depending on AI_PROVIDER.
AI_ENDPOINT=
AI_DAILY_LIMIT=10
