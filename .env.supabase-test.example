# TESTING ONLY. Copy to .env.supabase-test and fill locally. Never commit secrets.
# Use the dedicated UCE Testing project on the FREE plan, with dummy data only.
UCE_SUPABASE_TEST_ONLY=true
SUPABASE_TEST_PROJECT_REF=fqccfciqaakvxezfwhty
SUPABASE_URL=https://fqccfciqaakvxezfwhty.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
SUPABASE_SECRET_KEY=replace_with_SERVER_ONLY_secret_key
# Copy the session-pooler connection from Connect. Use port 5432 (not 6543).
# URL-encode password characters. Keep schema=uce_test and sslmode=require.
DATABASE_URL=postgresql://postgres.fqccfciqaakvxezfwhty:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=uce_test&sslmode=require&connection_limit=3
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# No AWS keys, payment keys or AI keys are needed.
